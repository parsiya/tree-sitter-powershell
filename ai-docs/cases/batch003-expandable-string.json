[
  {
    "name": "minimal quoted array before adjacent subexpression",
    "source": "Show-Thing \"a\", \"one\"$($x)",
    "expect": "valid"
  },
  {
    "name": "expandable array item closes before adjacent subexpression",
    "source": "Show-Thing -Text 'prefix', \"Status $($entry.Name): ', \"$($failure.Message) -Tone Blue, Gray",
    "expect": "valid"
  },
  {
    "name": "single quote array item before adjacent variable",
    "source": "Show-Thing 1, 'last'$value -Quiet",
    "expect": "valid"
  },
  {
    "name": "quoted array before adjacent word",
    "source": "Show-Thing $first, \"last\"tail -Quiet",
    "expect": "valid"
  },
  {
    "name": "quoted array before adjacent quote",
    "source": "Show-Thing 'first', \"last\"'next'",
    "expect": "valid"
  },
  {
    "name": "quoted array before adjacent parenthesis",
    "source": "Show-Thing 'first', \"last\"($value)",
    "expect": "valid"
  },
  {
    "name": "quoted array before adjacent member",
    "source": "Show-Thing 'first', \"last\"$item.Name",
    "expect": "valid"
  },
  {
    "name": "quoted array before adjacent comma list",
    "source": "Show-Thing 'first', \"last\"$value, 'next' -Quiet",
    "expect": "valid"
  },
  {
    "name": "attached parameter quoted array",
    "source": "Show-Thing -Text:'first', \"last\"$($value) -Quiet",
    "expect": "valid"
  },
  {
    "name": "bareword array before adjacent subexpression",
    "source": "Show-Thing first, \"last\"$($value)",
    "expect": "valid"
  },
  {
    "name": "mixed array before adjacent subexpression",
    "source": "Show-Thing 'first', middle, \"last\"$($value)",
    "expect": "valid"
  },
  {
    "name": "quoted array across CRLF",
    "source": "Show-Thing \"first\",\r\n \"last\"$($value) -Quiet\r\nShow-Thing done",
    "expect": "valid"
  },
  {
    "name": "quoted array smart delimiters",
    "source": "Show-Thing ‘first’, “last”$($value)",
    "expect": "valid"
  },
  {
    "name": "escaped quote remains inside string",
    "source": "Show-Thing 'first', \"a`\"$($value)z\" -Quiet",
