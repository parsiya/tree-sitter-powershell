    "source": "Show-Thing 'first', \"last\" $($value) -Quiet",
    "expect": "valid"
  },
  {
    "name": "comma after quote continues array",
    "source": "Show-Thing 'first', \"last\", $($value) -Quiet",
    "expect": "valid"
  },
  {
    "name": "single quoted argument adjacency control",
    "source": "Show-Thing \"last\"$($value) -Quiet",
    "expect": "valid"
  },
  {
    "name": "bare variable before subexpression remains one word",
    "source": "Show-Thing $first, $last$($value)tail -Quiet",
