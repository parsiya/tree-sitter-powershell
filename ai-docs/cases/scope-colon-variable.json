[
  {"name": "bare empty scope", "source": "$::\n"},
  {"name": "empty scope member", "source": "$::.Name\n"},
  {"name": "empty scope member chain", "source": "$::.Name.Other\n"},
  {"name": "empty scope member call", "source": "$::.Name.Run(1)\n"},
  {"name": "empty scope invoke operator", "source": "$::.Name |=> Run $::.Other.Prop\n"},
  {"name": "empty scope assigned", "source": "$value = $::.Name |=> Get\n"},
  {"name": "empty scope index", "source": "$map[$::.Name.Key]\n"},
  {"name": "empty scope argument", "source": "$v.Test($::.Name.All)\n"},
  {"name": "empty scope block call", "source": ". {}.module.run($::.Name.Script)\n"},
  {"name": "empty scope command argument", "source": "Write-Output $::.Name\n"},
  {"name": "empty scope command argument chain", "source": "Write-Output $::.Name.Other more\n"},
  {"name": "empty scope command argument bare", "source": "Write-Output $::\n"},
  {"name": "empty scope command argument name", "source": "Write-Output $::name $::name.Prop\n"},
  {"name": "empty scope command name", "source": "$::.Name.Run\n"},
  {"name": "empty scope index direct", "source": "$::[0]\n"},
  {"name": "empty scope plus name", "source": "$::name\n"},
  {"name": "empty scope plus name member", "source": "$::name.Prop\n"},
  {"name": "empty scope plus name static", "source": "$::name::Prop\n"},
  {"name": "empty scope path", "source": "$::x:y\n"},
  {"name": "empty scope question", "source": "$::?\n"},
  {"name": "empty scope digit", "source": "$::1\n"},
  {"name": "single empty scope name", "source": "$:x\n"},
  {"name": "single empty scope path", "source": "$:x:y\n"},
  {"name": "single empty scope static", "source": "$:x::y\n"},
  {"name": "single empty scope command argument", "source": "Write-Output $:x $:x:y\n"},
  {"name": "empty scope arithmetic", "source": "$::-1\n"},
  {"name": "empty scope assign", "source": "$::=1\n"},
  {"name": "empty scope statement end", "source": "$::;\n"},
  {"name": "braced empty scope", "source": "${::}\n"},
  {"name": "braced empty scope member", "source": "${::}.Name\n"},
  {"name": "global double colon", "source": "$global::x\n"},
  {"name": "global scope", "source": "$global:x\n"},
  {"name": "global scope path", "source": "$a:b:c\n"},
  {"name": "variable static member", "source": "$x::Name\n"},
  {"name": "variable static member call", "source": "$x::Name()\n"},
  {"name": "splat empty scope", "source": "Run @::\n"},
  {"name": "splat empty scope name", "source": "Run @::x @:x\n"},
  {"name": "string empty scope", "source": "\"$::.Name\"\n"},
  {"name": "string empty scope name", "source": "\"a $::name b $:x\"\n"},
  {"name": "string text colon", "source": "\"cost: $5 and $x :: done\"\n"},
  {"name": "assignment target", "source": "$::.Name = 1\n"},
  {"name": "dollar alone", "source": "$ \n"},
  {"name": "single colon alone", "source": "$:\n", "expect": "invalid"},
  {"name": "single colon before dot", "source": "$:.Name\n", "expect": "invalid"},
  {"name": "scope with empty name", "source": "$global:\n", "expect": "invalid"},
  {"name": "static access without member", "source": "$a::\n", "expect": "invalid"},
  {"name": "empty scope static access without member", "source": "$:::\n", "expect": "invalid"},
  {"name": "empty scope dot without member", "source": "$::.\n", "expect": "invalid"},
  {"name": "empty scope open brace", "source": "$::{\n", "expect": "invalid"}
]
