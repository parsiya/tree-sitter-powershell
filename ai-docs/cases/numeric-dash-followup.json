 {
  "name": "root test Numeric dash: malformed decimal-looking words",
  "source": "Invoke-Example -123abc -1foo -1e -1e+ -1.2.3"
 },
 {
  "name": "root test Numeric dash: dot-leading words",
  "source": "Invoke-Example -.thing -. -.."
 },
 {
  "name": "root test Numeric dash: punctuation stays in a word",
  "source": "Invoke-Example -1:tail -1=value -1+2 -1/2 -1%tail"
 },
 {
  "name": "root test Numeric dash: escaped punctuation",
  "source": "Invoke-Example -4tuln`;tail -4tuln`\"tail"
 },
 {
  "name": "root test Numeric dash: attached redirection-like text is a word",
  "source": "Invoke-Example -4tuln>out -1>out -.5>out"
 },
 {
  "name": "root test Numeric dash: command boundaries",
  "source": "Invoke-Example -4tuln | Get-Next\nInvoke-Example -4tuln; Get-Next"
 },
 {
  "name": "root test Numeric dash: preserve inherited pure-negative public CST",
  "source": "Invoke-Example -1 -1.5 -.5 -0x10 -1kb"
 },
 {
  "name": "root test Numeric dash: preserve expression-mode negation",
  "source": "$result = -1\nInvoke-Example (-1)"
 },
 {
  "name": "root test Numeric dash: preserve subtraction and ordinary parameters",
  "source": "$result = $left - $right\nInvoke-Example -Name value -A5"
 },
 {
  "name": "Numeric dash adjacency: preserve a leading single-quoted argument",
  "source": "Invoke-Example 'head'-.thing"
 },
 {
  "name": "Numeric dash adjacency: preserve a leading expandable quoted argument",
  "source": "Invoke-Example \"$value\"-4tuln"
 },
 {
  "name": "Numeric dash adjacency: attached quoted tail stays in the second argument",
  "source": "Invoke-Example \"head\"-4tuln\"tail\""
 },
 {
  "name": "Numeric dash adjacency: attached variable stays in the second argument",
  "source": "Invoke-Example \"head\"-4tuln$value"
 },
 {
  "name": "Numeric dash adjacency: nested command stays visible in the second argument",
  "source": "Invoke-Example \"head\"-4tuln$(Get-Nested)"
 },
 {
  "name": "Numeric dash adjacency: array tail stays with the second argument",
  "source": "Invoke-Example \"head\"-4tuln,last"
 },
 {
  "name": "Numeric dash adjacency: a failed lookahead preserves an ordinary parameter",
  "source": "Invoke-Example \"head\"-Name value"
 },
 {
  "name": "Numeric dash adjacency: a failed lookahead preserves a double-dash option",
  "source": "Invoke-Example \"head\"--name=value"
 },
